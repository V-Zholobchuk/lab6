FLASK_SECRET_KEY=replace_with_random_secret_key
DB_NAME=auth_system.db
MAX_FAILED_ATTEMPTS=3
LOCKOUT_MINUTES=15

# Початковий обліковий запис адміністратора
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password

# Налаштування SMTP для реальної відправки листів (наприклад, Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_email@gmail.com

# Реальний вхід через Google OpenID Connect та GitHub OAuth 2.0
# Callback URL для Google: http://127.0.0.1:5000/oauth/callback/google
# Callback URL для GitHub: http://127.0.0.1:5000/oauth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
